{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小芽家庭学习",
  "version": "0.2.11",
  "identifier": "cn.family-learning.xiaoya",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小芽家庭学习",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
