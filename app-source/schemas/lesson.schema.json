{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FAMILY_LEARNING_LESSON_V1",
  "type": "object",
  "required": ["protocol", "schemaVersion", "lessonId", "generatedAt", "basedOnSessionIds", "title", "tasks"],
  "properties": {
    "protocol": { "const": "FAMILY_LEARNING_LESSON_V1" },
    "schemaVersion": { "const": 1 },
    "lessonId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "basedOnSessionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "isBootstrap": { "type": "boolean" },
    "title": { "type": "string", "minLength": 1 },
    "teacherNote": { "type": "string" },
    "metadata": { "type": "object" },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["taskId", "subject", "questionType", "isNew", "prompt", "target", "hint", "demonstration"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "subject": { "enum": ["hanzi", "english_letter", "math"] },
          "questionType": { "enum": ["recognition", "choice"] },
          "evidenceType": { "type": "string", "minLength": 1 },
          "isNew": { "type": "boolean" },
          "prompt": { "type": "string", "minLength": 1 },
          "speechPrompt": { "type": "string", "minLength": 1 },
          "visualPrompt": { "type": "string", "minLength": 1 },
          "composition": {
            "type": "object",
            "required": ["whole", "left"],
            "properties": {
              "whole": { "type": "integer", "minimum": 2, "maximum": 5 },
              "left": { "type": "integer", "minimum": 1, "maximum": 4 }
            },
            "additionalProperties": false
          },
          "reinforcement": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object", "required": ["ref", "display"],
            "properties": { "ref": { "type": "string" }, "display": { "type": "string" } },
            "additionalProperties": false
          },
          "context": { "type": "string" },
          "hint": { "type": "string", "minLength": 1 },
          "demonstration": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" }, "uniqueItems": true },
          "correctAnswer": { "type": "string" }
        },
        "allOf": [{ "if": { "properties": { "questionType": { "const": "choice" } } }, "then": { "required": ["options", "correctAnswer"] } }],
        "additionalProperties": false
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "metadata": { "required": ["testScope"] } }, "required": ["metadata"] },
    "then": { "properties": { "tasks": { "maxItems": 2000 } } },
    "else": { "properties": { "tasks": { "maxItems": 20 } } }
  }],
  "additionalProperties": false
}
