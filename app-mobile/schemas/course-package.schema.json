{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "XIAOYA_COURSE_PACKAGE_V1",
  "title": "小芽课程包",
  "description": "公开包只含通用课程定义；family-private包仅用于登录后家庭云端同步，保留软件确认的已教待测和正式状态。",
  "type": "object",
  "required": [
    "protocol",
    "schemaVersion",
    "generatedAt",
    "catalog",
    "summary"
  ],
  "properties": {
    "protocol": {
      "const": "XIAOYA_COURSE_PACKAGE_V1"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "studentCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "catalog": {
      "type": "object",
      "required": [
        "hanzi",
        "english_letter",
        "math"
      ],
      "properties": {
        "hanzi": {
          "$ref": "#/$defs/catalogItems"
        },
        "english_letter": {
          "$ref": "#/$defs/catalogItems"
        },
        "math": {
          "$ref": "#/$defs/catalogItems"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "formalItemCount",
        "mathTotal"
      ],
      "properties": {
        "hanziLearned": {
          "type": "integer",
          "minimum": 0
        },
        "letterLearned": {
          "type": "integer",
          "minimum": 0
        },
        "mathLearned": {
          "type": "integer",
          "minimum": 0
        },
        "mathTotal": {
          "type": "integer",
          "minimum": 0
        },
        "hanziNeedsAssessment": {
          "type": "integer",
          "minimum": 0
        },
        "letterNeedsAssessment": {
          "type": "integer",
          "minimum": 0
        },
        "mathNeedsAssessment": {
          "type": "integer",
          "minimum": 0
        },
        "formalItemCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "lesson": {
      "anyOf": [
        {
          "$ref": "FAMILY_LEARNING_LESSON_V1"
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "enum": [
        "public-generic",
        "family-private"
      ]
    }
  },
  "$defs": {
    "catalogItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "display",
          "optionDisplay"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "optionDisplay": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "未学",
              "初见",
              "学习中",
              "薄弱",
              "会认",
              "能指认",
              "能说出",
              "理解",
              "稳定掌握"
            ]
          },
          "lastSeenAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "incorrectCount": {
            "type": "integer",
            "minimum": 0
          },
          "parentConfirmedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "needsAssessment": {
            "type": "boolean"
          },
          "association": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "stageName": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "level": {
            "type": [
              "integer",
              "null"
            ]
          },
          "nextReviewAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "family-private"
          }
        },
        "required": [
          "visibility"
        ]
      },
      "then": {
        "required": [
          "studentCode"
        ],
        "properties": {
          "summary": {
            "required": [
              "hanziLearned",
              "letterLearned",
              "mathLearned"
            ]
          },
          "catalog": {
            "properties": {
              "hanzi": {
                "items": {
                  "required": [
                    "status",
                    "incorrectCount",
                    "needsAssessment"
                  ]
                }
              },
              "english_letter": {
                "items": {
                  "required": [
                    "status",
                    "incorrectCount",
                    "needsAssessment"
                  ]
                }
              },
              "math": {
                "items": {
                  "required": [
                    "status",
                    "incorrectCount",
                    "needsAssessment"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
